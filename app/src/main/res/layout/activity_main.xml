<?xml version="1.0" encoding="utf-8"?>

<!--
    Home page. The middle part (page_container) shows one of:
    - the home (start training button + last sessions)   -> fragment_home.xml
    - the gym session in progress                        -> fragment_gym_session.xml
    - the run session in progress                        -> fragment_run_session.xml
    - the swim session in progress                       -> fragment_swim_session.xml
    (see MainActivity.showCurrentPage)
    The calendar slides in from the left (DrawerLayout), like the menu of the profile.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainDrawer"
    tools:context=".MainActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">


    <!-- spacer (status bar) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>


    <!--************************************** bottom strip **************************************-->
    <include
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>


    <!--************************************** calendar (Drawer) **************************************-->
    <include
        layout="@layout/calendar_drawer"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"/>

</androidx.drawerlayout.widget.DrawerLayout>
