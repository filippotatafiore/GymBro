<?xml version="1.0" encoding="utf-8"?>

<!-- "Settings" page of the sliding menu of the profile: modify account (username, email,
     password: res/layout/modify_account_menu.xml) and delete account -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="@drawable/drawer_background">

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <TextView
        android:id="@+id/menu_title"
        style="@style/ProfileMenuTitleStyle"
        android:gravity="center"
        android:text="@string/settings"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>

    <!-- Menu items -->

    <Button
        android:id="@+id/modifyAccountButton"
        style="@style/ProfileMenuItemStyle"
        android:text="@string/modify_account"/>

    <!-- asks for confirmation (with the password) -->
    <Button
        android:id="@+id/deleteAccountButton"
        style="@style/ProfileMenuItemStyle"
        android:textColor="@color/errorRed"
        android:text="@string/delete_acc"/>


    <!-- spacer to place last item at the bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/backmenuButton"
        style="@style/RoundIconButtonStyle"
        android:layout_marginStart="16dp"
        android:contentDescription="@string/back"
        android:src="@drawable/back_arrow_icon"/>

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"/>

</LinearLayout>
