<?xml version="1.0" encoding="utf-8"?>

<!-- A statistic of a run, e.g. AVG SPEED 10.2 km/h (tiles created by StatGrid.kt) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/list_row_background">

    <TextView
        android:id="@+id/statLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textColor="@color/textSecondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        tools:text="AVG SPEED"/>

    <!-- autoSize: long values (e.g. "1:02:05") shrink instead of being cut -->
    <TextView
        android:id="@+id/statValue"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="16sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        tools:text="10.2 km/h"/>

</LinearLayout>
