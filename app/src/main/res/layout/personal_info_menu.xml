<?xml version="1.0" encoding="utf-8"?>

<!-- "Personal information" page of the sliding menu of the profile: body data of the user (height,
     weight, year of birth, sex) and BMI. Filled and saved by ProfileActivity.showPersonalInfoForm -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/accountMenu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="@drawable/drawer_background">

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <TextView
        style="@style/ProfileMenuTitleStyle"
        android:gravity="center"
        android:text="@string/personal_information"/>

    <!-- ScrollView: the form can scroll when the keyboard is open -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/FormLabelStyle"
                android:layout_marginTop="4dp"
                android:text="@string/height_label"/>

            <EditText
                android:id="@+id/profileHeightInput"
                style="@style/InputStyle"
                android:layout_marginTop="6dp"
                android:hint="@string/height_hint"
                android:inputType="numberDecimal"
                android:importantForAutofill="no"/>

            <TextView
                style="@style/FormLabelStyle"
                android:text="@string/weight_label"/>

            <EditText
                android:id="@+id/profileWeightInput"
                style="@style/InputStyle"
                android:layout_marginTop="6dp"
                android:hint="@string/weight_hint"
                android:inputType="numberDecimal"
                android:importantForAutofill="no"/>

            <TextView
                style="@style/FormLabelStyle"
                android:text="@string/birth_year_label"/>

            <EditText
                android:id="@+id/profileBirthYearInput"
                style="@style/InputStyle"
                android:layout_marginTop="6dp"
                android:hint="@string/birth_year_hint"
                android:inputType="number"
                android:maxLength="4"
                android:importantForAutofill="no"/>

            <TextView
                style="@style/FormLabelStyle"
                android:text="@string/sex_label"/>

            <RadioGroup
                android:id="@+id/profileSexGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/sexMale"
                    style="@style/SegmentStyle"
                    android:layout_marginEnd="4dp"
                    android:textSize="13sp"
                    android:text="@string/sex_male"/>

                <RadioButton
                    android:id="@+id/sexFemale"
                    style="@style/SegmentStyle"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:textSize="13sp"
                    android:text="@string/sex_female"/>

                <RadioButton
                    android:id="@+id/sexOther"
                    style="@style/SegmentStyle"
                    android:layout_marginStart="4dp"
                    android:textSize="13sp"
                    android:text="@string/sex_other"/>

            </RadioGroup>

            <!-- e.g. "BMI 22.4 · normal weight", updated while typing -->
            <TextView
                android:id="@+id/profileBmiText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="15sp"
                tools:text="BMI 22.4 · normal weight"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                android:text="@string/account_hint"/>

            <TextView
                android:id="@+id/profileError"
                style="@style/ErrorTextStyle"/>

            <Button
                android:id="@+id/saveProfileButton"
                style="@style/PrimaryButtonStyle"
                android:layout_marginTop="16dp"
                android:text="@string/save"/>

        </LinearLayout>

    </ScrollView>

    <ImageButton
        android:id="@+id/backmenuButton"
        style="@style/RoundIconButtonStyle"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/back"
        android:src="@drawable/back_arrow_icon"/>

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"/>

</LinearLayout>
