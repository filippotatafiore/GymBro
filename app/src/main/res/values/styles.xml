<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ButtonStyle1">
        <item name="android:layout_width">200sp</item>
        <item name="android:layout_height">80sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@color/lightBlue</item>
    </style>

    <style name="TextStyle1">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lighterBlue</item>
        <item name="android:textSize">20sp</item>
    </style>


    <!-- ************************************ Home page ************************************ -->
    <style name="TitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lighterBlue</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="ContainerStyle1">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingLeft">60dp</item>
        <item name="android:paddingRight">60dp</item>
        <item name="android:background">@color/lighterGrey</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="sessionDate">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
    </style>



    <!-- ************************************ Profile page ************************************ -->
    <style name="ProfileMenuTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lightBlue</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">25sp</item>
    </style>

    <style name="ProfileMenuItemStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">start</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">20sp</item>
    </style>

</resources>