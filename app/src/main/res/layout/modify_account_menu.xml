<?xml version="1.0" encoding="utf-8"?>

<!-- "Modify account" page of the settings of the profile: username, email, new password (optional)
     and the current password, always needed. Filled and saved by ProfileActivity.showModifyAccountForm -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="@drawable/drawer_background">

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <TextView
        style="@style/ProfileMenuTitleStyle"
        android:gravity="center"
        android:text="@string/modify_account"/>

    <!-- ScrollView: the form can scroll when the keyboard is open -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/FormLabelStyle"
                android:layout_marginTop="4dp"
                android:text="@string/username"/>

            <EditText
                android:id="@+id/accountUsernameInput"
                style="@style/InputStyle"
                android:layout_marginTop="6dp"
                android:inputType="text"
                android:maxLength="30"
                android:importantForAutofill="no"/>

            <TextView
                style="@style/FormLabelStyle"
                android:text="@string/email"/>

            <EditText
                android:id="@+id/accountEmailInput"
                style="@style/InputStyle"
                android:layout_marginTop="6dp"
                android:inputType="textEmailAddress"
                android:importantForAutofill="no"/>

            <TextView
                style="@style/FormLabelStyle"
                android:text="@string/new_password_label"/>

            <EditText
                android:id="@+id/accountNewPasswordInput"
                style="@style/InputStyle"
                android:layout_marginTop="6dp"
                android:hint="@string/new_password_hint"
                android:inputType="textPassword"
                android:importantForAutofill="no"/>

            <EditText
                android:id="@+id/accountConfirmPasswordInput"
                style="@style/InputStyle"
                android:layout_marginTop="8dp"
                android:hint="@string/confirm_password_hint"
                android:inputType="textPassword"
                android:importantForAutofill="no"/>

            <TextView
                style="@style/FormLabelStyle"
                android:text="@string/current_password_label"/>

            <EditText
                android:id="@+id/accountCurrentPasswordInput"
                style="@style/InputStyle"
                android:layout_marginTop="6dp"
                android:inputType="textPassword"
                android:importantForAutofill="no"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                android:text="@string/modify_account_hint"/>

            <TextView
                android:id="@+id/accountError"
                style="@style/ErrorTextStyle"/>

            <Button
                android:id="@+id/saveAccountButton"
                style="@style/PrimaryButtonStyle"
                android:layout_marginTop="16dp"
                android:text="@string/save"/>

        </LinearLayout>

    </ScrollView>

    <ImageButton
        android:id="@+id/backmenuButton"
        style="@style/RoundIconButtonStyle"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/back"
        android:src="@drawable/back_arrow_icon"/>

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"/>

</LinearLayout>
