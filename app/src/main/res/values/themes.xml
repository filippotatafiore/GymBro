<?xml version="1.0" encoding="utf-8"?>
<!--
    Themes of the app. Light / dark: the "Base" themes, here (light) and in res/values-night/themes.xml
    (dark); the colors of the two themes are in res/values/colors.xml and res/values-night/colors.xml.
    Favorite color of the user: one of the Accent.* styles, applied on top of the theme of every
    page (ThemedActivity, see Appearance.kt).
-->
<resources>
    <style name="Base.Theme.GymBro" parent="android:Theme.Material.Light.NoActionBar"/>
    <style name="Base.ModalDialogTheme" parent="android:Theme.Material.Light.Dialog.NoActionBar"/>

    <style name="Theme.GymBro" parent="Base.Theme.GymBro">
        <!-- page color while the pages are opening: no flashes -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
        <!-- the default favorite color, until the one of the user is applied -->
        <item name="accentColor">@color/accent_blue</item>
        <item name="onAccentColor">@color/accent_blue_on</item>
        <item name="accentTextColor">@color/accent_blue_text</item>
        <item name="accentSoftColor">@color/accent_blue_soft</item>
        <item name="android:colorAccent">@color/accent_blue</item>
        <item name="android:colorControlActivated">@color/accent_blue</item>
        <item name="android:textColorHighlight">@color/accent_blue_soft</item>
    </style>

    <!-- Theme of the modal windows: transparent window (the card is drawn by the layout),
         dimmed background and custom enter/exit animations. The favorite color comes from the page. -->
    <style name="ModalDialogTheme" parent="Base.ModalDialogTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/ModalAnimation</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
    </style>


    <!-- ************************ favorite colors (Accent.*, see Appearance.kt) ************************ -->
