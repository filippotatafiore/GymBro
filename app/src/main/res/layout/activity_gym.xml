<?xml version="1.0" encoding="utf-8"?>

<!-- Gym page: list of the exercises of the session -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".GymActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lightGrey">


    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
    <!--************************************** top strip **************************************-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:src="@drawable/back_arrow_icon"/>

        <TextView
            style="@style/TopStripTitleStyle"
            android:text="@string/gym_session"/>

        <!-- spacer: same width as the back button, keeps the title centered -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"/>

    </LinearLayout>
    <!--************************************** top strip **************************************-->



    <!-- exercise list (each row is res/layout/item_exercise.xml) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/exerciseList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_exercise"/>



    <!--************************************** bottom strip **************************************-->
    <!-- bottom navbar -->
    <include
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"/>

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="@color/darkGrey"/>
    <!--************************************** bottom strip **************************************-->

</LinearLayout>
