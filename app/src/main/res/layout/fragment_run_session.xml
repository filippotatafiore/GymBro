<?xml version="1.0" encoding="utf-8"?>

<!-- Run session in progress: map that follows the current GPS position -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".session.RunSessionFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/session_top_strip"/>

    <!-- rounded frame around the map -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/list_row_background"
        android:clipToOutline="true">

        <!-- Google Map -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- shown until the first GPS position arrives -->
        <TextView
            android:id="@+id/gpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/modal_background"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:text="@string/searching_position"
            android:visibility="gone"/>

        <!-- shown instead of a blank map when the Google Maps API key is missing -->
        <TextView
            android:id="@+id/mapKeyMissing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:padding="20dp"
            android:gravity="center"
            android:background="@drawable/modal_background"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:text="@string/maps_key_missing"
            android:visibility="gone"/>

    </FrameLayout>

</LinearLayout>
