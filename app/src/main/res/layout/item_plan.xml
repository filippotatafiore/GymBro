<?xml version="1.0" encoding="utf-8"?>

<!-- A workout plan: card of the horizontal list WORKOUT PLANS of a profile (tap it to open it), with
     "PUBLIC" (everyone sees it on your profile) and "ACTIVE" (followed by your gym sessions) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="176dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/list_row_background"
    android:foreground="@drawable/row_ripple">

    <!-- minHeight: the height of the icon, also when it is hidden (all the cards equally tall) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- hidden when both the labels are shown: there is no room for it -->
        <ImageView
            android:id="@+id/planCardIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:src="@drawable/dumbbell_icon"
            android:tint="?attr/accentTextColor"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- everyone can see the plan on the profile -->
        <TextView
            android:id="@+id/planCardPublic"
            style="@style/SoftBadgeStyle"
            android:drawableStart="@drawable/globe_badge_icon"
            android:text="@string/public_badge"
            android:visibility="gone"
            tools:visibility="visible"/>

        <!-- the plan followed by the gym sessions -->
        <TextView
            android:id="@+id/planCardActive"
            style="@style/BadgeStyle"
            android:layout_marginStart="6dp"
            android:text="@string/active_badge"
            android:visibility="gone"
            tools:visibility="visible"/>

    </LinearLayout>

    <TextView
        android:id="@+id/planCardName"
        style="@style/RowTitleStyle"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Hypertrophy · 4 days"/>

    <TextView
        android:id="@+id/planCardInfo"
        style="@style/RowSubtitleStyle"
        android:textColor="?attr/accentTextColor"
        android:textStyle="bold"
        android:textSize="13sp"
        tools:text="4 days · Build muscle"/>

    <TextView
        android:id="@+id/planCardDate"
        style="@style/RowSubtitleStyle"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        tools:text="Updated Oct 15, 2026"/>

</LinearLayout>
