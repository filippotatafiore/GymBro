<?xml version="1.0" encoding="utf-8"?>

<!-- Modal window of the "Publish" button of the profile: publish a finished session, a manual
     result or a workout plan (it becomes public) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ModalCardStyle">

    <TextView
        style="@style/ModalTitleStyle"
        android:text="@string/publish_result_title"/>

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>

    <LinearLayout
        android:id="@+id/publishSessionOption"
        style="@style/PublishOptionStyle">

        <ImageView
            style="@style/PublishOptionIconStyle"
            android:src="@drawable/timer_icon"
            android:importantForAccessibility="no"/>

        <TextView
            style="@style/PublishOptionTextStyle"
            android:text="@string/publish_from_session"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/publishManualOption"
        style="@style/PublishOptionStyle">

        <ImageView
            style="@style/PublishOptionIconStyle"
            android:padding="5dp"
            android:src="@drawable/plus_icon"
            android:importantForAccessibility="no"/>

        <TextView
            style="@style/PublishOptionTextStyle"
            android:text="@string/publish_manual"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/publishPlanOption"
        style="@style/PublishOptionStyle">

        <ImageView
            style="@style/PublishOptionIconStyle"
            android:src="@drawable/dumbbell_icon"
            android:importantForAccessibility="no"/>

        <TextView
            style="@style/PublishOptionTextStyle"
            android:text="@string/publish_plan"/>

    </LinearLayout>

</LinearLayout>
