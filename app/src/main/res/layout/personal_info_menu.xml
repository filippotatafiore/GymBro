<?xml version="1.0" encoding="utf-8"?>

<!-- "Personal information" page of the sliding menu of the profile: body data of the user (height,
     weight, year of birth, sex) and BMI (res/layout/form_personal_info.xml, profile/PersonalInfoForm.kt) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/accountMenu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="@drawable/drawer_background">

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <TextView
        style="@style/ProfileMenuTitleStyle"
        android:gravity="center"
        android:text="@string/personal_information"/>

    <!-- ScrollView: the form can scroll when the keyboard is open -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <include layout="@layout/form_personal_info"/>

        </LinearLayout>

    </ScrollView>

    <ImageButton
        android:id="@+id/backmenuButton"
        style="@style/RoundIconButtonStyle"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/back"
        android:src="@drawable/back_arrow_icon"/>

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"/>

</LinearLayout>
