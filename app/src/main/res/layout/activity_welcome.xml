<?xml version="1.0" encoding="utf-8"?>

<!-- First page of the app when nobody is logged in: only register / log in (no bottom strip) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".WelcomeActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/background">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/dumbbell_icon"
        android:tint="?attr/accentTextColor"
        android:importantForAccessibility="no"
        tools:ignore="UseAppTint"/>
    <!-- UseAppTint: app:tint works only in AppCompat activities; this one is a ComponentActivity -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:textSize="44sp"
        android:text="@string/app_name"/>

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <TextView
        style="@style/TextStyle1"
        android:text="@string/register_invitation"/>

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"/>

    <Button
        android:id="@+id/register_Button"
        style="@style/ButtonStyle1"
        android:text="@string/register"/>

    <Button
        android:id="@+id/loginButton"
        style="@style/LinkButtonStyle"
        android:layout_marginTop="16dp"
        android:text="@string/already_member"/>

</LinearLayout>
