<?xml version="1.0" encoding="utf-8"?>

<!-- Calendar sliding from the left of the home (calendar button): the days of a month, with a
     green dot under the days with at least one session (home/CalendarDrawer.kt) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendarDrawer"
    android:layout_width="250dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:background="@drawable/drawer_background_start"
    android:clickable="true"
    android:focusable="true">

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <TextView
        style="@style/ProfileMenuTitleStyle"
        android:gravity="center"
        android:text="@string/calendar"/>

    <!-- < month year > -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/calendarPrevMonth"
            style="@style/SmallRoundIconButtonStyle"
            android:contentDescription="@string/previous_month"
            android:src="@drawable/back_arrow_icon"/>

        <TextView
            android:id="@+id/calendarMonthTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            tools:text="October 2026"/>

        <ImageButton
            android:id="@+id/calendarNextMonth"
            style="@style/SmallRoundIconButtonStyle"
            android:rotation="180"
            android:contentDescription="@string/next_month"
            android:src="@drawable/back_arrow_icon"/>

    </LinearLayout>

    <!-- names of the days of the week (filled by CalendarDrawer) -->
    <LinearLayout
        android:id="@+id/calendarWeekDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"/>

    <!-- one row per week; days: res/layout/item_calendar_day.xml -->
    <LinearLayout
        android:id="@+id/calendarGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        android:textColor="@color/textSecondary"
        android:textSize="13sp"
        android:text="@string/calendar_hint"/>

</LinearLayout>
