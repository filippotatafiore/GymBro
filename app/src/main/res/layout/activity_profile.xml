<?xml version="1.0" encoding="utf-8"?>


<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ProfileActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:gravity="top|center_horizontal"
        android:orientation="vertical">

        <!-- spacer (status bar) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

        <!--************************************** top strip **************************************-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/menuButton"
                style="@style/RoundIconButtonStyle"
                android:contentDescription="@string/menu"
                android:src="@drawable/menu_icon"/>

        </LinearLayout>
        <!--************************************** top strip **************************************-->


        <!-- the page scrolls: personal bests, workout plans and posts can all be long -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/profileScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

        <!-- picture (tap it to change it), posts, followers and followed users, username, email -->
        <include layout="@layout/profile_header"/>


        <!-- ************************* personal bests ************************* -->
        <TextView
            style="@style/SectionTitleStyle"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/personal_bests"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <!-- horizontal list: each card is res/layout/item_personal_best.xml -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/personalBestList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                tools:listitem="@layout/item_personal_best"
                tools:orientation="horizontal"/>

            <TextView
                android:id="@+id/emptyPersonalBestsText"
                style="@style/EmptyListTextStyle"
                android:padding="12dp"
                android:text="@string/no_personal_bests"
                android:visibility="gone"/>

        </FrameLayout>


        <!-- ************************* workout plans (written by the AI coach) ************************* -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <TextView
                style="@style/SectionTitleStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/workout_plans"/>

            <!-- the coach creates a new plan -->
            <Button
                android:id="@+id/newPlanButton"
                style="@style/SmallButtonStyle"
                android:drawableStart="@drawable/plus_icon"
                android:text="@string/new_plan"/>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <!-- horizontal list: each card is res/layout/item_plan.xml -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/planList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                tools:listitem="@layout/item_plan"
                tools:orientation="horizontal"/>

            <TextView
                android:id="@+id/emptyPlansText"
                style="@style/EmptyListTextStyle"
                android:padding="12dp"
                android:text="@string/no_plans_yet"
                android:visibility="gone"/>

        </FrameLayout>


        <!-- ************************* posts ************************* -->
        <LinearLayout
            android:id="@+id/postsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <TextView
                style="@style/SectionTitleStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/posts_title"/>

            <Button
                android:id="@+id/publishResultButton"
                style="@style/SmallButtonStyle"
                android:drawableStart="@drawable/plus_icon"
                android:text="@string/publish"/>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <!-- each row is res/layout/item_post.xml. It does not scroll by itself: the whole
                 page scrolls -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/postList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_post"/>

            <TextView
                android:id="@+id/emptyResultsText"
                style="@style/EmptyListTextStyle"
                android:layout_gravity="top"
                android:text="@string/no_results_yet"
                android:visibility="gone"/>

        </FrameLayout>

        </LinearLayout>

        </androidx.core.widget.NestedScrollView>


        <!--************************************** bottom strip **************************************-->
        <include
            layout="@layout/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>





    <!--************************************** sliding menu (Drawer) **************************************-->
    <!-- sliding menu (navigation drawer) -->
    <FrameLayout
        android:id="@+id/menu_container"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="end">

        <include layout="@layout/profile_menu" />

    </FrameLayout>



    <!--************************************** sliding menu (Drawer) **************************************-->


</androidx.drawerlayout.widget.DrawerLayout>
