<?xml version="1.0" encoding="utf-8"?>

<!-- Glow behind the home icon of the bottom strip while a session is in progress -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:gravity="center"
        android:width="50dp"
        android:height="50dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="25dp"
                android:startColor="#A04FA8FF"
                android:centerColor="#404FA8FF"
                android:endColor="#004FA8FF"/>
        </shape>
    </item>

</layer-list>
