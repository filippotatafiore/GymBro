<?xml version="1.0" encoding="utf-8"?>

<!-- Modal window shown when "start training" is pressed: choose between a gym, a run and a swim session -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/modal_background">

    <TextView
        style="@style/ModalTitleStyle"
        android:text="@string/choose_training"/>

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Gym button -->
        <LinearLayout
            android:id="@+id/gymOption"
            style="@style/TrainingOptionStyle">

            <ImageView
                style="@style/TrainingOptionIconStyle"
                android:src="@drawable/dumbbell_icon"
                android:importantForAccessibility="no"/>

            <TextView
                style="@style/TrainingOptionTextStyle"
                android:text="@string/gym"/>

        </LinearLayout>

        <!-- spacer -->
        <View
            android:layout_width="12dp"
            android:layout_height="match_parent"/>

        <!-- Run button -->
        <LinearLayout
            android:id="@+id/runOption"
            style="@style/TrainingOptionStyle">

            <ImageView
                style="@style/TrainingOptionIconStyle"
                android:src="@drawable/shoe_icon"
                android:importantForAccessibility="no"/>

            <TextView
                style="@style/TrainingOptionTextStyle"
                android:text="@string/run"/>

        </LinearLayout>

        <!-- spacer -->
        <View
            android:layout_width="12dp"
            android:layout_height="match_parent"/>

        <!-- Swim button -->
        <LinearLayout
            android:id="@+id/swimOption"
            style="@style/TrainingOptionStyle">

            <ImageView
                style="@style/TrainingOptionIconStyle"
                android:src="@drawable/swim_icon"
                android:importantForAccessibility="no"/>

            <TextView
                style="@style/TrainingOptionTextStyle"
                android:text="@string/swim"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
