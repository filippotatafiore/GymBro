<?xml version="1.0" encoding="utf-8"?>

<!-- Modal window of the "Publish" button of the profile: publish a finished session or a manual result -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ModalCardStyle">

    <TextView
        style="@style/ModalTitleStyle"
        android:text="@string/publish_result_title"/>

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/publishSessionOption"
            style="@style/TrainingOptionStyle"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                style="@style/TrainingOptionIconStyle"
                android:src="@drawable/timer_icon"
                android:importantForAccessibility="no"/>

            <TextView
                style="@style/TrainingOptionTextStyle"
                android:gravity="center"
                android:textSize="16sp"
                android:text="@string/publish_from_session"/>

        </LinearLayout>

        <!-- spacer -->
        <View
            android:layout_width="16dp"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:id="@+id/publishManualOption"
            style="@style/TrainingOptionStyle"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                style="@style/TrainingOptionIconStyle"
                android:padding="8dp"
                android:src="@drawable/plus_icon"
                android:importantForAccessibility="no"/>

            <TextView
                style="@style/TrainingOptionTextStyle"
                android:gravity="center"
                android:textSize="16sp"
                android:text="@string/publish_manual"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
