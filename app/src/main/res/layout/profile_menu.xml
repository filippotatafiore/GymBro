<?xml version="1.0" encoding="utf-8"?>


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="@drawable/drawer_background">

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <TextView
        android:id="@+id/menu_title"
        style="@style/ProfileMenuTitleStyle"
        android:gravity="center"
        android:text="Menu"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>


    <!-- Menu items -->

    <Button
        android:id="@+id/menu_option_1"
        style="@style/ProfileMenuItemStyle"
        android:text="Option 1"/>

    <Button
        android:id="@+id/menu_option_2"
        style="@style/ProfileMenuItemStyle"
        android:text="Option 2"/>

    <!-- body data of the user: res/layout/account_menu.xml -->
    <Button
        android:id="@+id/modifyAccountButton"
        style="@style/ProfileMenuItemStyle"
        android:text="@string/modify_account"/>

    <Button
        android:id="@+id/menu_option_4"
        style="@style/ProfileMenuItemStyle"
        android:text="@string/delete_acc"/>


    <!-- spacer to place last item at the bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/logoutButton"
        style="@style/ProfileMenuItemStyle"
        android:text="@string/logout" />

    <Button
        android:id="@+id/settingsButton"
        style="@style/ProfileMenuItemStyle"
        android:text="@string/settings" />

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"/>

</LinearLayout>