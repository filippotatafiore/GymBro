<?xml version="1.0" encoding="utf-8"?>

<!-- Route planner, before a run: destination (and optional stop) chosen on the map or searched by
     name; the distance of the route is the goal of the run (RoutePlannerActivity.kt) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".session.RoutePlannerActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- spacer (status bar) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="44dp"/>

    <!-- back + search bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/plannerBackButton"
            style="@style/RoundIconButtonStyle"
            android:contentDescription="@string/back"
            android:src="@drawable/back_arrow_icon"/>

        <EditText
            android:id="@+id/placeSearchInput"
            style="@style/InputStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginTop="0dp"
            android:layout_marginStart="10dp"
            android:hint="@string/search_place_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:importantForAutofill="no"/>

        <ImageButton
            android:id="@+id/placeSearchButton"
            style="@style/RoundIconButtonStyle"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/search_place_hint"
            android:src="@drawable/search_icon"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/list_row_background"
        android:clipToOutline="true">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/plannerMap"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- results of the search: rows res/layout/item_place.xml -->
        <LinearLayout
            android:id="@+id/placeResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/modal_background"
            android:visibility="gone"/>

        <!-- e.g. "Searching for your position…" -->
        <TextView
            android:id="@+id/plannerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/modal_background"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- what a tap on the map sets, goal distance and start button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <RadioGroup
            android:id="@+id/pointModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:checkedButton="@+id/modeDestination">

            <RadioButton
                android:id="@+id/modeDestination"
                style="@style/SegmentStyle"
                android:layout_marginEnd="6dp"
                android:text="@string/destination"/>

            <RadioButton
                android:id="@+id/modeStop"
                style="@style/SegmentStyle"
                android:layout_marginStart="6dp"
                android:text="@string/stop_on_the_way"/>

        </RadioGroup>

        <TextView
            android:id="@+id/plannerHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/textSecondary"
            android:textSize="14sp"
            android:text="@string/planner_hint_destination"/>

        <!-- e.g. "Goal: 5.32 km" + "Walking route by Google Maps" -->
        <TextView
            android:id="@+id/plannedDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:textSize="22sp"
            android:fontFeatureSettings="tnum"
            android:visibility="gone"
            tools:text="Goal: 5.32 km"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/plannedRouteKind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Walking route by Google Maps"
            tools:visibility="visible"/>

        <Button
            android:id="@+id/removeStopButton"
            style="@style/LinkButtonStyle"
            android:layout_gravity="center_horizontal"
            android:text="@string/remove_stop"
            android:visibility="gone"/>

        <Button
            android:id="@+id/plannerStartButton"
            style="@style/PrimaryButtonStyle"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:alpha="0.5"
            android:text="@string/start_run"/>

    </LinearLayout>

</LinearLayout>
