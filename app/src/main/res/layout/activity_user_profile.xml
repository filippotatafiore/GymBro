<?xml version="1.0" encoding="utf-8"?>

<!--
    Profile of another user (logic in UserProfileActivity.kt), opened from the social page: picture,
    posts, followers and followed users, the button to follow them (or to stop), and to share a plan
    when they follow each other; then their personal bests, public workout plans and posts.
    Nothing can be changed here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/userProfileRoot"
    tools:context=".UserProfileActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- spacer (status bar) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <!--************************************** top strip **************************************-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/userProfileBackButton"
            style="@style/RoundIconButtonStyle"
            android:contentDescription="@string/back"
            android:src="@drawable/back_arrow_icon"/>

        <TextView
            android:id="@+id/userProfileTitle"
            style="@style/SectionTitleStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="marco.runs"/>

    </LinearLayout>
    <!--************************************** top strip **************************************-->


    <androidx.core.widget.NestedScrollView
        android:id="@+id/userProfileScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <include layout="@layout/profile_header"/>

            <!-- Follow / Unfollow, and Share a plan (they follow each other) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/followButton"
                    style="@style/PrimaryButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:enabled="false"
                    android:text="@string/follow"/>

                <Button
                    android:id="@+id/shareWithUserButton"
                    style="@style/SecondaryButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textSize="15sp"
                    android:text="@string/share_plan_button"
                    android:visibility="gone"
                    tools:visibility="visible"/>

            </LinearLayout>


            <!-- ************************* personal bests ************************* -->
            <TextView
                style="@style/SectionTitleStyle"
                android:layout_width="match_parent"
                android:layout_marginTop="24dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/personal_bests"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/userBestList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:clipToPadding="false"
                    tools:listitem="@layout/item_personal_best"
                    tools:orientation="horizontal"/>

                <TextView
                    android:id="@+id/userBestEmpty"
                    style="@style/EmptyListTextStyle"
                    android:padding="12dp"
                    android:text="@string/no_personal_bests_yet"
                    android:visibility="gone"/>

            </FrameLayout>


            <!-- ************************* public workout plans ************************* -->
            <TextView
                style="@style/SectionTitleStyle"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/workout_plans"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/userPlanList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:clipToPadding="false"
                    tools:listitem="@layout/item_plan"
                    tools:orientation="horizontal"/>

                <TextView
                    android:id="@+id/userPlansEmpty"
                    style="@style/EmptyListTextStyle"
                    android:padding="12dp"
                    android:text="@string/no_public_plans"
                    android:visibility="gone"/>

            </FrameLayout>


            <!-- ************************* posts ************************* -->
            <TextView
                android:id="@+id/userPostsTitle"
                style="@style/SectionTitleStyle"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/posts_title"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/userPostList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_post"/>

                <TextView
                    android:id="@+id/userPostsEmpty"
                    style="@style/EmptyListTextStyle"
                    android:layout_gravity="top"
                    android:text="@string/no_posts_yet"
                    android:visibility="gone"/>

            </FrameLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
