<?xml version="1.0" encoding="utf-8"?>

<!--
    Workout plans shared with one user (logic in ConversationActivity.kt): the plans sent on the
    right, those received on the left, oldest first (tap one to see it, and to add a received one to
    your plans). At the bottom the button to share one of your plans: only if you follow each other.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conversationRoot"
    tools:context=".ConversationActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- spacer (status bar) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <!--************************************** top strip **************************************-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/conversationBackButton"
            style="@style/RoundIconButtonStyle"
            android:contentDescription="@string/back"
            android:src="@drawable/back_arrow_icon"/>

        <!-- the user: tap to open the profile -->
        <LinearLayout
            android:id="@+id/conversationUser"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@drawable/menu_item_background">

            <ImageView
                android:id="@+id/conversationUserAvatar"
                style="@style/ProfilePictureStyle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/conversationUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="marco.runs"/>

        </LinearLayout>

    </LinearLayout>
    <!--************************************** top strip **************************************-->


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- res/layout/item_shared_plan.xml (SharedPlanAdapter) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sharedPlanList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_shared_plan"/>

        <TextView
            android:id="@+id/conversationEmptyText"
            style="@style/EmptyListTextStyle"
            android:visibility="gone"
            tools:text="@string/conversation_empty"/>

        <ProgressBar
            android:id="@+id/conversationLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/accentTextColor"/>

    </FrameLayout>

    <!-- they do not follow each other anymore -->
    <TextView
        android:id="@+id/cannotShareText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/textSecondary"
        android:textSize="13sp"
        android:text="@string/cannot_share_anymore"
        android:visibility="gone"/>

    <Button
        android:id="@+id/sharePlanButton"
        style="@style/PrimaryButtonStyle"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:enabled="false"
        android:text="@string/share_plan_title"/>

</LinearLayout>
