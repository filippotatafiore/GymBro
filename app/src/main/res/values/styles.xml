<?xml version="1.0" encoding="utf-8"?>
<!--
    Styles of the views. Colors: by role from res/values/colors.xml (they change with the light /
    dark theme) and ?attr/accent... for the favorite color of the user (res/values/attrs.xml).
-->
<resources>

    <!-- ************************************ Common ************************************ -->
    <!-- Big rounded button in the favorite color (start training, register) -->
    <style name="ButtonStyle1">
        <item name="android:layout_width">200sp</item>
        <item name="android:layout_height">80sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">?attr/onAccentColor</item>
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Full-width rounded buttons, used in the modal windows: main action in the favorite color -->
    <style name="PrimaryButtonStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/onAccentColor</item>
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SecondaryButtonStyle" parent="PrimaryButtonStyle">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:background">@drawable/button_secondary_background</item>
    </style>

    <style name="DangerButtonStyle" parent="PrimaryButtonStyle">
        <item name="android:textColor">@color/onColor</item>
        <item name="android:background">@drawable/button_danger_background</item>
    </style>

    <!-- Small tonal button with an icon (e.g. "+ Publish"): a light tint of the favorite color -->
    <style name="SmallButtonStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">?attr/accentTextColor</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/accentTextColor</item>
        <item name="android:background">@drawable/button_tonal_background</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Text-only button (e.g. "Already a member? Log in") -->
    <style name="LinkButtonStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/accentTextColor</item>
        <item name="android:background">@drawable/menu_item_background</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Round icon button (top strips: calendar, menu, pause, stop) -->
    <style name="RoundIconButtonStyle">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/round_icon_button_background</item>
    </style>

    <!-- Small round icon button in the rows of the lists (publish, delete) -->
    <style name="SmallRoundIconButtonStyle" parent="RoundIconButtonStyle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- Rounded text field -->
    <style name="InputStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Drop-down list, with the same look of the text fields -->
    <style name="SpinnerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:popupBackground">@drawable/modal_background</item>
    </style>

    <!-- Option of a choice (RadioButton), e.g. Time / Weight: the chosen one in the favorite color -->
    <style name="SegmentStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/segment_background</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Small grey label above a field of a form -->
    <style name="FormLabelStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Title of a section of a page (e.g. PERSONAL BESTS, MY RESULTS) -->
    <style name="SectionTitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/accentTextColor</item>
        <item name="android:textSize">21sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="ErrorTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/errorRed</item>
        <item name="android:textSize">14sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Grey text shown when a list is empty -->
    <style name="EmptyListTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">32dp</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextStyle1">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/accentTextColor</item>
        <item name="android:textSize">20sp</item>
    </style>


    <!-- ************************************ Home page ************************************ -->
    <style name="TitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/accentTextColor</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- A row of a list (sessions, exercises, results): rounded card with a thin border -->
    <style name="ListRowStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/list_row_background</item>
    </style>

    <style name="RowTitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="RowSubtitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Number on the right of a row (duration, sets x reps, result) -->
    <style name="RowValueStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/accentTextColor</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>


    <!-- ************************************ Active session ************************************ -->
    <style name="SessionTitleStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/accentTextColor</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="SessionTimerStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- Big buttons that add laps to a swim (+2, +4, +8, +10) -->
    <style name="LapButtonStyle" parent="PrimaryButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- e.g. CHEST: small label in the favorite color -->
    <style name="ExerciseMuscleGroupStyle" parent="RowSubtitleStyle">
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">?attr/accentTextColor</item>
        <item name="android:textSize">11sp</item>
    </style>


    <!-- ************************************ Profile page ************************************ -->
    <style name="ProfileMenuTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/accentTextColor</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="ProfileMenuItemStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">start</item>
        <item name="android:background">@drawable/menu_item_background</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">19sp</item>
    </style>

    <!-- Round profile picture: the background gives the circle shape, clipToOutline cuts the image -->
    <style name="ProfilePictureStyle">
        <item name="android:background">@drawable/avatar_circle</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:src">@drawable/default_avatar</item>
    </style>

    <!-- Posts / Followers / Following next to the profile picture: tap them (number above, name below) -->
    <style name="ProfileCountStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/menu_item_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ProfileCountValueStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="ProfileCountLabelStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>


    <!-- ************************************ Social page ************************************ -->
    <!-- Search field (users, followers): pill with a magnifying glass -->
    <style name="SearchFieldStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:drawableStart">@drawable/search_field_icon</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:background">@drawable/chat_input_background</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:singleLine">true</item>
        <item name="android:inputType">text</item>
        <item name="android:imeOptions">actionSearch</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <!-- Small label in the favorite color, e.g. PERSONAL BEST (feed and posts), ACTIVE (plans) -->
    <style name="BadgeStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">?attr/onAccentColor</item>
        <item name="android:background">@drawable/last_done_badge_background</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/onAccentColor</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- The same label with a light tint of the favorite color, e.g. PUBLIC (plans) -->
    <style name="SoftBadgeStyle" parent="BadgeStyle">
        <item name="android:drawableTint">?attr/accentTextColor</item>
        <item name="android:background">@drawable/badge_soft_background</item>
        <item name="android:textColor">?attr/accentTextColor</item>
    </style>



    <!-- ************************************ Chat page ************************************ -->
    <!-- Text of a message of the chat, in its bubble -->
    <style name="ChatBubbleTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Example question of the welcome of the chat: tap it to ask it -->
    <style name="ChatSuggestionStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/list_row_background</item>
        <item name="android:foreground">@drawable/row_ripple</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">15sp</item>
    </style>



    <!-- ************************************ Modal windows ************************************ -->
    <!-- (theme of the modal windows: ModalDialogTheme in res/values/themes.xml) -->
    <style name="ModalAnimation">
        <item name="android:windowEnterAnimation">@anim/modal_enter</item>
        <item name="android:windowExitAnimation">@anim/modal_exit</item>
    </style>

    <!-- Root of the layout of a modal window: rounded card with a thin border -->
    <style name="ModalCardStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">24dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">24dp</item>
        <item name="android:background">@drawable/modal_background</item>
    </style>

    <style name="ModalTitleStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/accentTextColor</item>
        <item name="android:textSize">23sp</item>
    </style>

    <style name="ModalMessageStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Gym / Run buttons: cards tinted with the favorite color -->
    <style name="TrainingOptionStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:background">@drawable/training_option_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TrainingOptionIconStyle">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">?attr/accentTextColor</item>
    </style>

    <!-- Options of the "Publish" window of the profile: rows tinted with the favorite color -->
    <style name="PublishOptionStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/publish_option_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="PublishOptionIconStyle">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">?attr/accentTextColor</item>
    </style>

    <style name="PublishOptionTextStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TrainingOptionTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">20sp</item>
    </style>

</resources>
