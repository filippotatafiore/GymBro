<?xml version="1.0" encoding="utf-8"?>

<!-- Sliding menu of the profile (logic in ProfileActivity: loadProfileMenu) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_menu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="@drawable/drawer_background">

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <TextView
        android:id="@+id/menu_title"
        style="@style/ProfileMenuTitleStyle"
        android:gravity="center"
        android:text="@string/menu"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>


    <!-- Menu items -->

    <!-- body data of the user: res/layout/personal_info_menu.xml -->
    <Button
        android:id="@+id/personalInfoButton"
        style="@style/ProfileMenuItemStyle"
        android:text="@string/personal_information"/>

    <!-- theme and favorite color: res/layout/customize_account_menu.xml -->
    <Button
        android:id="@+id/customizeAccountButton"
        style="@style/ProfileMenuItemStyle"
        android:text="@string/customize_account"/>


    <!-- spacer to place last item at the bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/logoutButton"
        style="@style/ProfileMenuItemStyle"
        android:text="@string/logout" />

    <!-- modify account, delete account: res/layout/manage_account_menu.xml -->
    <Button
        android:id="@+id/manageAccountButton"
        style="@style/ProfileMenuItemStyle"
        android:text="@string/manage_account" />

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"/>

</LinearLayout>
