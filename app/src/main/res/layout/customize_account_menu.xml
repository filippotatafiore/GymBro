<?xml version="1.0" encoding="utf-8"?>

<!-- "Customize account" page of the sliding menu of the profile: theme of the app (dark / light)
     and favorite color (swatches added by ProfileActivity.showCustomizeForm, res/layout/item_accent_swatch.xml).
     The choice is applied to the whole app right away and saved in the account. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="@drawable/drawer_background">

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="50dp"/>

    <TextView
        style="@style/ProfileMenuTitleStyle"
        android:gravity="center"
        android:text="@string/customize_account"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- theme -->
            <TextView
                style="@style/FormLabelStyle"
                android:layout_marginTop="4dp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:text="@string/theme_label"/>

            <RadioGroup
                android:id="@+id/themeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/themeDark"
                    style="@style/SegmentStyle"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:drawableStart="@drawable/moon_icon"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/segment_text"
                    android:textSize="14sp"
                    android:text="@string/theme_dark"/>

                <RadioButton
                    android:id="@+id/themeLight"
                    style="@style/SegmentStyle"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:drawableStart="@drawable/sun_icon"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/segment_text"
                    android:textSize="14sp"
                    android:text="@string/theme_light"/>

            </RadioGroup>

            <!-- favorite color -->
            <TextView
                style="@style/FormLabelStyle"
                android:layout_marginTop="24dp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:text="@string/favorite_color_label"/>

            <!-- rows of swatches: res/layout/item_accent_swatch.xml -->
            <LinearLayout
                android:id="@+id/accentGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"/>

            <!-- name of the chosen color, e.g. "Blue" -->
            <TextView
                android:id="@+id/accentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="?attr/accentTextColor"
                android:textSize="15sp"
                tools:text="Blue"/>

            <TextView
                android:id="@+id/appearanceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                android:text="@string/appearance_hint"/>

        </LinearLayout>

    </ScrollView>

    <ImageButton
        android:id="@+id/backmenuButton"
        style="@style/RoundIconButtonStyle"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/back"
        android:src="@drawable/back_arrow_icon"/>

    <!-- spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"/>

</LinearLayout>
