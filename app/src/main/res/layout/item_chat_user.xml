<?xml version="1.0" encoding="utf-8"?>

<!-- A message of the user in the chat (ChatAdapter): blue bubble on the right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="64dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/chatMessageText"
        style="@style/ChatBubbleTextStyle"
        android:layout_gravity="end"
        android:background="@drawable/chat_bubble_user"
        tools:text="How do I do a squat correctly?"/>

</FrameLayout>
