<?xml version="1.0" encoding="utf-8"?>

<!-- Send button of the chat: circle in the favorite color, neutral while there is nothing to send -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/surfaceVariant"/>
        </shape>
    </item>

    <item>
        <ripple android:color="#33FFFFFF">
            <item>
                <shape android:shape="oval">
                    <solid android:color="?attr/accentColor"/>
                </shape>
            </item>
        </ripple>
    </item>

</selector>
