<?xml version="1.0" encoding="utf-8"?>

<!-- A single row of the exercise list of the gym session -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ListRowStyle">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/exerciseName"
            style="@style/RowTitleStyle"
            tools:text="Bench Press"/>

        <TextView
            android:id="@+id/exerciseMuscleGroup"
            style="@style/ExerciseMuscleGroupStyle"
            tools:text="CHEST"/>

    </LinearLayout>

    <!-- sets x reps -->
    <TextView
        android:id="@+id/exerciseSetsReps"
        style="@style/RowValueStyle"
        tools:text="4 × 8"/>

</LinearLayout>
