<?xml version="1.0" encoding="utf-8"?>

<!-- Modal window to choose one of your workout plans (logic in PlanPicker.kt): to share it with
     another user (Messages) or to publish it on your profile.
     ConstraintLayout: lets the list grow up to a maximum height, then it scrolls. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:background="@drawable/modal_background">

    <TextView
        android:id="@+id/planPickerTitle"
        style="@style/ModalTitleStyle"
        android:layout_width="0dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="@string/share_plan_title"/>

    <TextView
        android:id="@+id/planPickerMessage"
        style="@style/ModalMessageStyle"
        android:layout_width="0dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/planPickerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="marco.runs will receive a copy of the plan as it is now."/>

    <!-- each row is res/layout/item_plan_choice.xml; tap one to choose it -->
    <FrameLayout
        android:id="@+id/planPickerFrame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="380dp"
        app:layout_constraintTop_toBottomOf="@id/planPickerMessage"
        app:layout_constraintBottom_toTopOf="@id/planPickerProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/planPickerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_plan_choice"/>

        <TextView
            android:id="@+id/planPickerEmpty"
            style="@style/EmptyListTextStyle"
            android:visibility="gone"
            tools:text="@string/no_plans_to_share"/>

    </FrameLayout>

    <!-- while the chosen plan is sent -->
    <ProgressBar
        android:id="@+id/planPickerProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:indeterminateTint="?attr/accentTextColor"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/planPickerFrame"
        app:layout_constraintBottom_toTopOf="@id/planPickerError"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/planPickerError"
        style="@style/ErrorTextStyle"
        android:layout_width="0dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/planPickerProgress"
        app:layout_constraintBottom_toTopOf="@id/cancelButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/cancelButton"
        style="@style/LinkButtonStyle"
        android:layout_marginTop="8dp"
        android:text="@string/cancel"
        app:layout_constraintTop_toBottomOf="@id/planPickerError"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
