<?xml version="1.0" encoding="utf-8"?>


<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ProfileActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lightGrey"
        android:gravity="top|center_horizontal"
        android:orientation="vertical">

        <!-- spacer (status bar) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

        <!--************************************** top strip **************************************-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- visible only when logged in -->
            <ImageButton
                android:id="@+id/menuButton"
                style="@style/RoundIconButtonStyle"
                android:contentDescription="@string/menu"
                android:src="@drawable/menu_icon"
                android:visibility="gone"/>

        </LinearLayout>
        <!--************************************** top strip **************************************-->


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ********** not logged in: invitation to register / log in ********** -->
            <LinearLayout
                android:id="@+id/loggedOutView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/TextStyle1"
                    android:text="@string/register_invitation"/>

                <!-- spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="30dp"/>

                <Button
                    android:id="@+id/register_Button"
                    style="@style/ButtonStyle1"
                    android:text="@string/register"/>

                <Button
                    android:id="@+id/loginButton"
                    style="@style/LinkButtonStyle"
                    android:layout_marginTop="16dp"
                    android:text="@string/already_member"/>

            </LinearLayout>


            <!-- ********** logged in: profile ********** -->
            <LinearLayout
                android:id="@+id/loggedInView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- tap it to change the picture -->
                <ImageView
                    android:id="@+id/profilePicture"
                    style="@style/ProfilePictureStyle"
                    android:contentDescription="@string/profile_picture"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"/>

                <TextView
                    android:id="@+id/profileUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    tools:text="filippo"/>

                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp"
                    tools:text="filippo@example.com"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:textColor="@color/lighterBlue"
                        android:textSize="22sp"
                        android:text="@string/my_results"/>

                    <Button
                        android:id="@+id/publishResultButton"
                        style="@style/SmallButtonStyle"
                        android:drawableStart="@drawable/plus_icon"
                        android:text="@string/publish"/>

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp">

                    <!-- each row is res/layout/item_result.xml -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/resultList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingBottom="8dp"
                        android:clipToPadding="false"
                        tools:listitem="@layout/item_result"/>

                    <TextView
                        android:id="@+id/emptyResultsText"
                        style="@style/EmptyListTextStyle"
                        android:layout_gravity="top"
                        android:text="@string/no_results_yet"
                        android:visibility="gone"/>

                </FrameLayout>

            </LinearLayout>

        </FrameLayout>


        <!--************************************** bottom strip **************************************-->
        <include
            layout="@layout/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>





    <!--************************************** sliding menu (Drawer) **************************************-->
    <!-- sliding menu (navigation drawer), usable only when logged in -->
    <FrameLayout
        android:id="@+id/menu_container"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="end">

        <include layout="@layout/profile_menu" />

    </FrameLayout>



    <!--************************************** sliding menu (Drawer) **************************************-->


</androidx.drawerlayout.widget.DrawerLayout>
