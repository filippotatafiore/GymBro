<?xml version="1.0" encoding="utf-8"?>

<!-- Button to mark an exercise of the gym session as done: green circle when done (selected),
     empty grey circle otherwise -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/successGreen"/>
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/textSecondary"/>
        </shape>
    </item>

</selector>
